# Chỉ cấu hình hạ tầng một lần. 5-key pool được cập nhật runtime qua
# /api/apify-config, không lưu Apify token trong environment hoặc source code.
APIFY_ACTOR_ID=zen-studio/shopee-product-reviews-scraper
# Production luôn chạy 3 filter 5★/3★/1★ song song, 20 review mỗi tầng.
# Demo 20 review chỉ còn dùng qua options.mode='demo' trong test/local.
SHOPEE_REVIEWS_PER_STAR=20
APIFY_RUN_TIMEOUT_MS=70000
# Công tắc độc lập cho luồng lấy review. Bỏ trống hoặc true = hoạt động;
# false/0/off/no = trả lỗi bảo trì trước cache, pool key và actor.
SHOPEE_REVIEW_ENABLED=true
TIKTOK_REVIEW_ENABLED=true
# Phí Actor start Shopee của zen-studio, đơn vị micro-USD (0,008 USD).
# Dataset rỗng vẫn phát sinh phí này nhưng không tăng bộ đếm lượt có dữ liệu.
SHOPEE_ACTOR_STARTUP_FEE_MICRO_USD=8000

# Khóa mã hóa pool token. Tạo một lần bằng:
# openssl rand -base64 32
APIFY_TOKEN_VAULT_KEY=
APIFY_ADMIN_KEY=

# Blog CMS: danh sách email/user id, phân cách bằng dấu phẩy. Admin có quyền
# publish/unpublish/archive; editor chỉ tạo, sửa và xem trước bài viết.
BLOG_ADMIN_EMAILS=
BLOG_EDITOR_EMAILS=
BLOG_ADMIN_USER_IDS=
BLOG_EDITOR_USER_IDS=

# Tìm một sản phẩm tương tự trên sàn còn lại sau khi result đã trả về. Google
# Lens (qua SerpApi) tạo candidate theo ảnh; Vertex multimodal embedding là lớp
# xác nhận tùy chọn. Actor chỉ là fallback và lấy token từ pool Redis hiện tại.
# Mọi fallback đều bị chặn nếu không còn đủ ngân sách chừa 20 lượt Shopee/key.
# Đặt false để tắt riêng tính năng này mà không ảnh hưởng pipeline phân tích.
COUNTERPART_SEARCH_ENABLED=true
GOOGLE_LENS_SERPAPI_KEY=
# JSON service account có thể để nguyên một dòng hoặc base64. Service account
# cần quyền gọi Vertex AI; bỏ trống để dùng perceptual hash local làm fallback.
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_VERTEX_LOCATION=us-central1
COUNTERPART_LENS_TIMEOUT_MS=18000
COUNTERPART_VERTEX_TIMEOUT_MS=15000
COUNTERPART_TIKTOK_SEARCH_ACTOR_ID=pro100chok/tiktok-shop-scraper-usage
COUNTERPART_SHOPEE_SEARCH_ACTOR_ID=zen-studio/shopee-product-scraper
COUNTERPART_SEARCH_TIMEOUT_MS=70000
# Reservation bảo thủ cho một Actor fallback; chi phí thật được chốt từ run.
COUNTERPART_TIKTOK_SEARCH_MAX_COST_MICRO_USD=250000
COUNTERPART_SHOPEE_SEARCH_MAX_COST_MICRO_USD=200000

# Upstash Redis được Vercel Marketplace tự động inject khi kết nối integration.
# Code cũng chấp nhận tên tương thích KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Tài khoản, danh sách email, phiên đăng nhập và lịch sử người dùng được lưu
# trong namespace realview:account:v1 của cùng kho Redis.

# Chuyển tiếp biểu mẫu liên hệ đến realviewueh@gmail.com qua Gmail SMTP.
# GMAIL_APP_PASSWORD phải được lưu dưới dạng secret trên Vercel, không commit giá trị thật.
# Nếu chưa cấu hình, nội dung vẫn được lưu trong namespace realview:contact:v1.
GMAIL_SMTP_USER=realviewueh@gmail.com
GMAIL_APP_PASSWORD=

# Gemini chỉ được đọc ở backend. Không đưa khóa này vào public/ hoặc JavaScript trình duyệt.
GEMINI_API_KEY=
# Optional: key riêng cho chatbot. Chatbot thử key này trước, sau đó tối đa một
# key dự phòng từ pool/GEMINI_API_KEY trong ngân sách chung 5,5 giây.
# Chỉ chatbot đọc biến này; model cố định gemini-3.5-flash-lite.
CHATBOT_GEMINI_API_KEY=
# Pool Gemini runtime được mã hóa trong Redis. Tạo khóa vault một lần bằng:
# openssl rand -base64 32
GEMINI_API_KEY_VAULT_KEY=
# Nếu bỏ trống, API quản trị Gemini dùng APIFY_ADMIN_KEY.
GEMINI_ADMIN_KEY=
# Router cố định Gemini 3.5 Flash Lite; không cấu hình chuỗi model fallback.
GEMINI_MODEL=gemini-3.5-flash-lite
# Router luôn giới hạn một lần gọi ban đầu + tối đa 2 retry; toàn pipeline Gemini có ngân sách 14,5 giây.
# Optional: thay quota Flash Lite nếu Google thay đổi hạn mức project của bạn.
# Mặc định: 15 RPM, 250k TPM, 500 RPD.
# GEMINI_MODEL_LIMITS_JSON={"gemini-3.5-flash-lite":{"rpm":15,"tpm":250000,"rpd":500}}
# true = tách availability, lỗi và hiệu năng; EWMA cũ giảm trọng số theo thời gian.
# false = rollback về cách tính health/route score cũ mà không rollback code.
GEMINI_HEALTH_SCORING_V2=true

# Layer 2 labeler: all = kiểm tra toàn bộ review; uncertain = chỉ review mơ hồ;
# off = chỉ chạy keyword Layer 1.
LABELER_LLM_MODE=uncertain
LABELER_LLM_BATCH_SIZE=20
LABELER_GEMINI_MODEL=gemini-3.5-flash-lite
# Scheduler chỉ thay đổi số batch chạy đồng thời; không thay đổi rule, prompt
# hoặc quyền phủ định/sửa nhãn Layer 1 của Gemini Layer 2.
LAYER2_ADAPTIVE_CONCURRENCY=true
LAYER2_BASE_CONCURRENCY=3
LAYER2_MAX_CONCURRENCY=10
# Dùng khi tắt adaptive để quay lại hành vi cũ.
LAYER2_FIXED_CONCURRENCY=2
LAYER2_ESTIMATED_BATCH_MS=22000
LAYER2_DEADLINE_BUFFER_MS=5000
LAYER2_MIN_START_BUDGET_MS=8000
# Chừa một route khỏe cho TrustScore/chatbot khi pool có nhiều hơn một route.
LAYER2_RESERVED_ROUTES=1

# Vercel Blob. Token này lưu private review datasets và revision Blog CMS;
# ảnh blog đã tối ưu WebP được lưu public để dùng trực tiếp trên trang bài viết.
BLOB_READ_WRITE_TOKEN=

# Mặc định true: ưu tiên raw dataset TikTok của đúng productId, còn hạn năm ngày,
# trước khi gọi Apify. Đặt false để rollback về luồng luôn gọi actor trực tiếp.
# Cache TikTok không yêu cầu đủ năm tầng sao vì actor tạm lấy mẫu không phân tầng.
TIKTOK_RECENT_RAW_CACHE=true

# true = dùng actor TikTok tạm thời; false hoặc bỏ trống = dùng actor gốc.
TIKTOK_USE_TEMPORARY_ACTOR=false
APIFY_TIKTOK_TEMPORARY_REGION=VN
TIKTOK_CIRCUIT_FAILURE_THRESHOLD=3
TIKTOK_CIRCUIT_OPEN_MS=300000

# Chỉ dùng local. Mặc định: ./data/review-runs
REVIEW_DATA_DIR=

# Optional. Chỉ đặt calibrated=true sau khi p0 được ước lượng từ tập đối chứng
# cùng ngành hàng, cùng thị trường và cùng giai đoạn. Nếu bỏ trống, hệ thống vẫn
# tính TrustScore nhưng chỉ hiển thị kiểm định binomial theo p0 ví dụ ở chế độ tham khảo.
# TRUST_BASELINES_JSON={"calibrated":true,"source":"Shopee VN control set 2026-Q3","values":{"electronics":{"su-dung":0.015,"giao-hang":0.04},"fashion":{"kich-co":0.03,"chat-lieu":0.02,"giao-hang":0.04},"beauty":{"dung-mo-ta":0.025,"giao-hang":0.04},"general":{"giao-hang":0.04}}}

# Optional: required only when a TikTok Shop collector is deployed.
REVIEWS_BOT_URL=
REVIEWS_BOT_TOKEN=

# Local-only switch for the UI demo fallback.
ALLOW_DEMO_REVIEWS=false

