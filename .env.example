# Chỉ cấu hình hạ tầng một lần. 5-key pool được cập nhật runtime qua
# /api/apify-config, không lưu Apify token trong environment hoặc source code.
APIFY_ACTOR_ID=zen-studio/shopee-product-reviews-scraper
# Production luôn chạy 3 filter 5★/3★/1★ song song, 20 review mỗi tầng.
# Demo 20 review chỉ còn dùng qua options.mode='demo' trong test/local.
SHOPEE_REVIEWS_PER_STAR=20
APIFY_RUN_TIMEOUT_MS=70000

# Khóa mã hóa pool token. Tạo một lần bằng:
# openssl rand -base64 32
APIFY_TOKEN_VAULT_KEY=
APIFY_ADMIN_KEY=

# Upstash Redis được Vercel Marketplace tự động inject khi kết nối integration.
# Code cũng chấp nhận tên tương thích KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini chỉ được đọc ở backend. Không đưa khóa này vào public/ hoặc JavaScript trình duyệt.
GEMINI_API_KEY=
# Pool Gemini runtime được mã hóa trong Redis. Tạo khóa vault một lần bằng:
# openssl rand -base64 32
GEMINI_API_KEY_VAULT_KEY=
# Nếu bỏ trống, API quản trị Gemini dùng APIFY_ADMIN_KEY.
GEMINI_ADMIN_KEY=
# Router cố định Gemini 3.5 Flash Lite; không cấu hình chuỗi model fallback.
GEMINI_MODEL=gemini-3.5-flash-lite
# Router luôn giới hạn một lần gọi ban đầu + tối đa 2 retry; toàn pipeline Gemini có ngân sách 14,5 giây.
# Optional: thay quota Flash Lite nếu Google thay đổi hạn mức project của bạn.
# Mặc định: 15 RPM, 250k TPM, 500 RPD.
# GEMINI_MODEL_LIMITS_JSON={"gemini-3.5-flash-lite":{"rpm":15,"tpm":250000,"rpd":500}}

# Layer 2 labeler: all = kiểm tra toàn bộ review; uncertain = chỉ review mơ hồ;
# off = chỉ chạy keyword Layer 1.
LABELER_LLM_MODE=uncertain
LABELER_LLM_BATCH_SIZE=20
LABELER_GEMINI_MODEL=gemini-3.5-flash-lite

# Vercel Blob private store. Khi deploy trên Vercel, bắt buộc có token này nếu
# muốn lưu bền vững hai file reviews.raw.json và reviews.labeled.json mỗi lượt.
BLOB_READ_WRITE_TOKEN=

# Chỉ dùng local. Mặc định: ./data/review-runs
REVIEW_DATA_DIR=

# Optional. Chỉ đặt calibrated=true sau khi p0 được ước lượng từ tập đối chứng
# cùng ngành hàng, cùng thị trường và cùng giai đoạn. Nếu bỏ trống, hệ thống vẫn
# tính TrustScore nhưng chỉ hiển thị kiểm định binomial theo p0 ví dụ ở chế độ tham khảo.
# TRUST_BASELINES_JSON={"calibrated":true,"source":"Shopee VN control set 2026-Q3","values":{"electronics":{"su-dung":0.015,"giao-hang":0.04},"fashion":{"kich-co":0.03,"chat-lieu":0.02,"giao-hang":0.04},"beauty":{"dung-mo-ta":0.025,"giao-hang":0.04},"general":{"giao-hang":0.04}}}

# Optional: required only when a TikTok Shop collector is deployed.
REVIEWS_BOT_URL=
REVIEWS_BOT_TOKEN=

# Local-only switch for the UI demo fallback.
ALLOW_DEMO_REVIEWS=false
