{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/analyze.mjs": {
      "maxDuration": 180
    },
    "api/analyze-stream.mjs": {
      "maxDuration": 180
    },
    "api/chat.mjs": {
      "maxDuration": 30
    },
    "api/auth.mjs": {
      "maxDuration": 10
    },
    "api/history.mjs": {
      "maxDuration": 10
    },
    "api/contact.mjs": {
      "maxDuration": 10
    },
    "api/article-views.mjs": {
      "maxDuration": 10
    },
    "api/apify-config.mjs": {
      "maxDuration": 10
    },
    "api/gemini-config.mjs": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/realview-logo-v1.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/favicon-v1-32.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/favicon-v1-48.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/apple-touch-icon-v1.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/illustrations/open-doodles-laying-v1.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/api/analyze", "destination": "/api/analyze.mjs" },
    { "source": "/api/analyze-stream", "destination": "/api/analyze-stream.mjs" },
    { "source": "/api/chat", "destination": "/api/chat.mjs" },
    { "source": "/api/auth", "destination": "/api/auth.mjs" },
    { "source": "/api/history", "destination": "/api/history.mjs" },
    { "source": "/api/contact", "destination": "/api/contact.mjs" },
    { "source": "/api/article-views", "destination": "/api/article-views.mjs" },
    { "source": "/api/apify-config", "destination": "/api/apify-config.mjs" },
    { "source": "/api/gemini-config", "destination": "/api/gemini-config.mjs" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}

