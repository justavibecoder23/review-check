{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/analyze.mjs": {
      "maxDuration": 180
    },
    "api/analyze-stream.mjs": {
      "maxDuration": 180
    },
    "api/chat.mjs": {
      "maxDuration": 30
    },
    "api/match-counterpart.mjs": {
      "maxDuration": 120
    },
    "api/auth.mjs": {
      "maxDuration": 10
    },
    "api/history.mjs": {
      "maxDuration": 10
    },
    "api/contact.mjs": {
      "maxDuration": 10
    },
    "api/apify-config.mjs": {
      "maxDuration": 10
    },
    "api/gemini-config.mjs": {
      "maxDuration": 10
    },
    "api/chatbot-gemini-config.mjs": {
      "maxDuration": 10
    },
    "api/blog.mjs": {
      "maxDuration": 30,
      "includeFiles": "public/blog{.html,/**}"
    }
  },
  "headers": [
    {
      "source": "/blog/snapshots/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/blog-recovered/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/realview-logo-v1.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/favicon-v1-32.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/favicon-v1-48.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/apple-touch-icon-v1.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/illustrations/open-doodles-laying-v1.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/admin/blog",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/admin-blog.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/admin/access",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/admin-access.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/criteria.html", "destination": "/tieu-chi-loc", "permanent": true },
    { "source": "/contact.html", "destination": "/lien-he", "permanent": true },
    { "source": "/blog.html", "destination": "/bai-viet", "permanent": true },
    { "source": "/blog/cach-doc-review-thong-minh.html", "destination": "/bai-viet/review-san-pham-la-gi", "permanent": true },
    { "source": "/blog/trustscore-la-gi.html", "destination": "/bai-viet/trustscore-la-gi", "permanent": true },
    { "source": "/blog/kiem-tra-do-tin-cay-review-truoc-khi-mua-hang.html", "destination": "/bai-viet/kiem-tra-do-tin-cay-review-truoc-khi-mua-hang", "permanent": true },
    { "source": "/blog/shopee-hay-tiktok-shop-mua-hang-o-dau-tot-hon.html", "destination": "/bai-viet/shopee-hay-tiktok-shop-mua-hang-o-dau-tot-hon", "permanent": true },
    { "source": "/blog/shopee-mall-la-gi-co-nen-mua-khong.html", "destination": "/bai-viet/shopee-mall-la-gi-co-nen-mua-khong", "permanent": true },
    { "source": "/blog/tiktok-shop-la-gi-mua-hang-tren-tiktok-co-an-toan-khong.html", "destination": "/bai-viet/tiktok-shop-la-gi-mua-hang-tren-tiktok-co-an-toan-khong", "permanent": true },
    { "source": "/blog/cach-tim-shop-uy-tin-tren-shopee.html", "destination": "/bai-viet/cach-tim-shop-uy-tin-tren-shopee", "permanent": true },
    { "source": "/blog/review-san-pham-la-gi.html", "destination": "/bai-viet/review-san-pham-la-gi", "permanent": true },
    { "source": "/blog/review-san-pham-co-dang-tin-khong.html", "destination": "/bai-viet/review-san-pham-co-dang-tin-khong", "permanent": true },
    { "source": "/blog/review-gia-la-gi-dau-hieu-nhan-biet.html", "destination": "/bai-viet/review-gia-la-gi-dau-hieu-nhan-biet", "permanent": true },
    { "source": "/results.html", "destination": "/ket-qua", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/analyze", "destination": "/api/analyze.mjs" },
    { "source": "/api/analyze-stream", "destination": "/api/analyze-stream.mjs" },
    { "source": "/api/match-counterpart", "destination": "/api/match-counterpart.mjs" },
    { "source": "/api/chat", "destination": "/api/chat.mjs" },
    { "source": "/api/auth", "destination": "/api/auth.mjs" },
    { "source": "/api/history", "destination": "/api/history.mjs" },
    { "source": "/api/contact", "destination": "/api/contact.mjs" },
    { "source": "/api/apify-config", "destination": "/api/apify-config.mjs" },
    { "source": "/api/gemini-config", "destination": "/api/gemini-config.mjs" },
    { "source": "/api/chatbot-gemini-config", "destination": "/api/chatbot-gemini-config.mjs" },
    { "source": "/api/admin-blog", "destination": "/api/blog.mjs?route=admin" },
    { "source": "/api/admin-access", "destination": "/api/blog.mjs?route=access-admin" },
    { "source": "/api/blog-public", "destination": "/api/blog.mjs?route=public" },
    { "source": "/admin/blog", "destination": "/admin-blog.html" },
    { "source": "/admin/access", "destination": "/admin-access.html" },
    { "source": "/sitemap.xml", "destination": "/blog/snapshots/sitemap-snapshot.xml" },
    { "source": "/bai-viet/rss.xml", "destination": "/api/blog.mjs?route=rss" },
    { "source": "/tieu-chi-loc", "destination": "/criteria.html" },
    { "source": "/lien-he", "destination": "/contact.html" },
    { "source": "/bai-viet", "destination": "/blog/snapshots/index-snapshot.html" },
    { "source": "/bai-viet/trang-check-review-uy-tin-5-cong-cu-dang-biet", "destination": "/blog/snapshots/trang-check-review-uy-tin-5-cong-cu-dang-biet.html" },
    { "source": "/bai-viet/realview-la-gi-cach-su-dung-realview-de-check-review-san-pham-shopee-va-tiktok-shop", "destination": "/blog/snapshots/realview-la-gi-cach-su-dung-realview-de-check-review-san-pham-shopee-va-tiktok-shop.html" },
    { "source": "/bai-viet/vi-sao-realview-huu-ich", "destination": "/blog/snapshots/vi-sao-realview-huu-ich.html" },
    { "source": "/bai-viet/tips-kiem-tra-review-san-pham-checklist-truoc-khi-mua-hang", "destination": "/blog/snapshots/tips-kiem-tra-review-san-pham-checklist-truoc-khi-mua-hang.html" },
    { "source": "/bai-viet/san-pham-nhieu-review-van-tiem-an-rui-ro", "destination": "/blog/snapshots/san-pham-nhieu-review-van-tiem-an-rui-ro.html" },
    { "source": "/bai-viet/check-review-la-gi-tai-sao-can-check-review-truoc-khi-dat-hang", "destination": "/blog/snapshots/check-review-la-gi-tai-sao-can-check-review-truoc-khi-dat-hang.html" },
    { "source": "/bai-viet/seeding-review-la-gi", "destination": "/blog/snapshots/seeding-review-la-gi.html" },
    { "source": "/bai-viet/seeding-review-shopee-tiktok", "destination": "/blog/snapshots/seeding-review-shopee-tiktok.html" },
    { "source": "/bai-viet/trustscore-la-gi", "destination": "/blog/snapshots/trustscore-la-gi.html" },
    { "source": "/bai-viet/review-san-pham-co-dang-tin-khong", "destination": "/blog/snapshots/review-san-pham-co-dang-tin-khong.html" },
    { "source": "/bai-viet/review-gia-la-gi-dau-hieu-nhan-biet", "destination": "/blog/snapshots/review-gia-la-gi-dau-hieu-nhan-biet.html" },
    { "source": "/bai-viet/review-san-pham-la-gi", "destination": "/blog/snapshots/review-san-pham-la-gi.html" },
    { "source": "/bai-viet/kiem-tra-do-tin-cay-review-truoc-khi-mua-hang", "destination": "/blog/snapshots/kiem-tra-do-tin-cay-review-truoc-khi-mua-hang.html" },
    { "source": "/bai-viet/shopee-hay-tiktok-shop-mua-hang-o-dau-tot-hon", "destination": "/blog/snapshots/shopee-hay-tiktok-shop-mua-hang-o-dau-tot-hon.html" },
    { "source": "/bai-viet/shopee-mall-la-gi-co-nen-mua-khong", "destination": "/blog/snapshots/shopee-mall-la-gi-co-nen-mua-khong.html" },
    { "source": "/bai-viet/tiktok-shop-la-gi-mua-hang-tren-tiktok-co-an-toan-khong", "destination": "/blog/snapshots/tiktok-shop-la-gi-mua-hang-tren-tiktok-co-an-toan-khong.html" },
    { "source": "/bai-viet/cach-tim-shop-uy-tin-tren-shopee", "destination": "/blog/snapshots/cach-tim-shop-uy-tin-tren-shopee.html" },
    { "source": "/bai-viet/:slug", "destination": "/api/blog.mjs?route=post&slug=:slug" },
    { "source": "/ket-qua", "destination": "/results.html" }
  ]
}

