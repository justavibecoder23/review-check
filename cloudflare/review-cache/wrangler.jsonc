{
  "name": "realview-review-cache",
  "main": "worker.mjs",
  "account_id": "84e83ee7665b51263769f065a0e9ad93",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "realview-review-cache",
    "database_id": "c1f00d27-7a10-4db6-bd93-b442f397b36e",
    "migrations_dir": "migrations"
  }],
  "env": {
    "preview": {
      "name": "realview-review-cache-preview",
      "d1_databases": [{
        "binding": "DB",
        "database_name": "realview-review-cache-preview",
        "database_id": "3c7545fc-175e-48c0-b0e5-f99277a3dc80",
        "migrations_dir": "migrations"
      }]
    }
  }
}
